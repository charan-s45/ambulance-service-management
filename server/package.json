{
  "name": "ambulance-service-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  },
  "description": "REST API for the Ambulance Service Management System (Express + MongoDB)",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "prod": "node --env-file-if-exists=.env server.js",
    "test": "node --test --test-concurrency=1 --import ./tests/setup.js \"tests/**/*.test.js\"",
    "create-admin": "node --env-file-if-exists=.env scripts/createAdmin.js",
    "seed": "node --env-file-if-exists=.env scripts/seedDemo.js",
    "import-legacy": "node --env-file-if-exists=.env scripts/importLegacy.js"
  }
}
