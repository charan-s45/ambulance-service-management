# Copy this file to ".env" and fill in real values. Never commit ".env".

# Port the API listens on
PORT=5000

# Local:  mongodb://127.0.0.1:27017/ambulance_service
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ambulance_service?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ambulance_service

# Front-end origin(s) allowed by CORS (comma-separated, no trailing slash)
CLIENT_URL=http://localhost:5173

# development | production | test
NODE_ENV=development

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-characters

# How long a login lasts before the user must sign in again
JWT_EXPIRES_IN=8h

# lax (React served from same site as API — recommended) | strict | none (cross-site hosting; requires HTTPS)
COOKIE_SAMESITE=lax

# Response-time estimate shown before a dispatcher/driver enters a real ETA.
# This is a configurable default, NOT a live GPS or route calculation.
DEFAULT_ETA_MINUTES=15

# true = serve the built React app (client/dist) from this server
SERVE_CLIENT=false

# Set to 1 when running behind one reverse proxy/load balancer (Render, Railway, Nginx)
TRUST_PROXY=0

# Secret code someone must type to register as an Admin on the website.
# Leave EMPTY to switch admin self-registration off (then use npm run create-admin).
# Use a long random value and share it only with people who should be admins.
ADMIN_REGISTRATION_CODE=
